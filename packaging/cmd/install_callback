#!/bin/bash
set -eu
umask 077
touch "${TRIM_PKGVAR}/.fnqbbridge-owned"
if [ -f "${TRIM_PKGVAR}/config.json" ]; then exit 0; fi
if ! [[ "${wizard_bridge_password:-}" =~ ^[A-Za-z0-9]{12,64}$ ]]; then exit 1; fi
printf '{"listen":":18080","port":7777,"password":"%s"}\n' "$wizard_bridge_password" > "${TRIM_PKGVAR}/config.json"
